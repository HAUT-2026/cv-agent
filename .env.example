# Rol 3 · configuración del LLM de los agentes. Copia como .env (no se sube a git).
# El cliente habla el protocolo de chat de OpenAI con tools: sirve para Ollama, OpenAI,
# Gemini, DeepSeek, Groq, LM Studio, vLLM… Cambiar de modelo es cambiar estas líneas.

# --- Ollama local (si el código corre en Docker y Ollama en el host: host.docker.internal) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODELO=qwen2.5:7b
LLM_API_KEY=ollama

# --- OpenAI (ejemplo) ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODELO=<modelo elegido>
# LLM_API_KEY=sk-...

LLM_TEMPERATURA=0
LLM_TIMEOUT=600
# 10 requisitos ≈ 1500 tokens de ficha; con 1000 la respuesta se corta.
LLM_MAX_TOKENS=2000
